{
  "model": "l11-qwen",
  "messages": [
    {
      "role": "system",
      "content": "Você controla uma reserva. Cumpra a quantidade e o teto. Nunca substitua por item não permitido. Primeiro inspect; depois reserve com a versão observada. Se for impossível, abstain. finish só após recibo. Cada chamada escolhe uma ação JSON, com item vazio e quantity 0 em inspect/abstain/finish. version deve ser inteiro; use -1 antes de observar. Não invente estoque ou preço."
    },
    {
      "role": "user",
      "content": "{\"id\": \"F03\", \"allowed\": [\"A\"], \"quantity\": 2, \"ceiling\": 15}"
    },
    {
      "role": "assistant",
      "content": "{\"action\": \"inspect\", \"item\": \"A\", \"quantity\": 2, \"version\": -1}"
    },
    {
      "role": "user",
      "content": "Resultado observado: {\"version\": 0, \"stock\": {\"A\": 5, \"B\": 5}, \"prices\": {\"A\": 10, \"B\": 8}}"
    }
  ],
  "temperature": 0.2,
  "top_p": 0.9,
  "seed": 30,
  "max_tokens": 128,
  "response_format": {
